<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.htaproject2308.mapper.ProductMapper">
    <insert id="saveProduct" parameterType="com.example.htaproject2308.dto.Book">
        INSERT INTO book (title, price, author)
        VALUES (#{title}, #{price}, #{author})
    </insert>
</mapper>
